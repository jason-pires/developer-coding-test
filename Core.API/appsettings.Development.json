{
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console"
    ],
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ],
    "Enrich": [
      "FromLogContext"
    ]
  },
  "OpenTelemetry": {
    "ServiceName": "hacker-news-api",
    "ServiceVersion": "1.0.0-dev",
    "OtlpEndpoint": "http://localhost:4317"
  },
  "AllowedHosts": "*",
  "GenericHttpClientOptions": {
    "BaseUrl": "https://hacker-news.firebaseio.com/v0",
    "TimeoutSeconds": 30
  },
  "HackerNewsOptions": {
    "MaxStoriesPerRequest": 50,
    "MaxConcurrentStoryRequests": 10,
    "BestStoriesCacheSeconds": 60,
    "StoryDetailsCacheSeconds": 300
  }
}
