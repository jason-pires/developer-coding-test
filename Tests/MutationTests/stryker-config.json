{
  "stryker-config": {
    "project": "Application.csproj",
    "solution": "../../Core.sln",
    "test-projects": [
      "../UnitTests/UnitTests.csproj"
    ],
    "target-framework": "net9.0",
    "reporters": [
      "html",
      "progress",
      "cleartext"
    ],
    "mutate": [
      "!**/obj/**/*.cs",
      "!**/bin/**/*.cs"
    ],
    "thresholds": {
      "high": 80,
      "low": 60,
      "break": 0
    }
  }
}
